{
  "hosting": {
    "public": "redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://homeschool.jrcanest.co/typing/",
        "type": 301
      },
      {
        "source": "/:rest*",
        "destination": "https://homeschool.jrcanest.co/typing/:rest*",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
